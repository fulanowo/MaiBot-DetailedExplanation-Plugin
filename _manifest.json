{
  "manifest_version": 2,
  "id": "fulanowo.detailed-explanation",
  "version": "2.0.0",
  "name": "麦麦细说 (Detailed Explanation Plugin)",
  "description": "需要详细解释、科普或深入分析时，直连模型生成结构化长文，按段落智能切分后逐段发送，并保留麦麦的人设与表达风格。支持关键词触发、主动命令与模型工具调用。",
  "author": {
    "name": "CharTyr",
    "url": "https://github.com/CharTyr"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/fulanowo/MaiBot-DetailedExplanation-Plugin.git",
    "homepage": "https://github.com/fulanowo/MaiBot-DetailedExplanation-Plugin",
    "issues": "https://github.com/fulanowo/MaiBot-DetailedExplanation-Plugin/issues"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.9.99"
  },
  "sdk": {
    "min_version": "2.8.1",
    "max_version": "2.99.99"
  },
  "capabilities": [
    "api.call",
    "config.get",
    "llm.generate",
    "llm.get_available_models",
    "message.get_by_time_in_chat",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "book-open"
    }
  },
  "changelog": "CHANGELOG.md"
}
